# 复制为 .env.staging.local。该文件不会被提交，也不会进入安装包。
# 仅 npm run staging:live 读取；真实请求会消耗此 Key 的 API 额度。
DAILY_FEED_STAGING_API_KEY=replace_with_your_api_key

# 可选：远程预发服务管理。地址和口令必须属于预发，不得填正式值。
DAILY_FEED_STAGING_RELAY=https://daily-feed-relay-staging.YOUR_SUBDOMAIN.workers.dev
DAILY_FEED_STAGING_ADMIN_TOKEN=replace_with_separate_staging_admin_token
